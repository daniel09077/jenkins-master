pipeline{
    agent{ 
        label 'maven-agent'
    }
    //tell jenkins which directory holds the java application 
    environment{
        mvnPRJDIR = 'java-with-maven/java'
    }
    stages{
        stage('Git checkout'){
                steps{
                    checkout scm
                }
        }
        stage('Validates'){
            steps{
                dir(env.mvnPRJDIR){
                    sh 'mvn validate'
                }
            }

        }
        stage('Maven-Test'){
            steps{
                dir(env.mvnPRJDIR){
                    sh 'mvn test'
                }
            }
        }
        stage('SAST with Sonarqube'){
            steps{
                dir(env.mvnPRJDIR){
                    withSonarQubeEnv('sonarqube token'){

                        sh ''' mvn clean verify org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                            -Dsonar.projectKey=maven-agent-scanner \
                            -Dsonar.projectName='maven-agent-scanner' \
                            -Dsonar.scanner.skipJreProvisioning=true
                        '''
                    }
        
                }
            }
        }
        stage('Deploy to Nexus'){
            steps{
               configFileProvider([configFile(fileId: 'maven-settings-file',
               variable: 'MAVEN-SETTINGS-FILE')])
               {
                    dir(env.MAVEN_PROJ_DIR){
                        withCredentials([usernamePassword(credentialsId: 'nexus-repo', 
                                    usernameVariable: 'NEXUS_USER', 
                                    passwordVariable: 'NEXUS_PASS')])
                                    {
                                        sh 'mvn deploy -s $MAVEN_SETTINGS-FILE'
                                        
                                    } 
                    }
               }
               
            }
        }
       
    }
}
